    {
      "id": "iquK49RxxXTKIBJ63Of_m",
      "type": "text",
      "x": -131.09268188476562,
      "y": 1547.6248397827148,
      "width": 456.5333251953125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#121212",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
