      "isDeleted": true,
      "boundElements": [],
      "updated": 1773201482626,
      "link": null,
      "locked": false,
      "text": "Client:\n- Generate Proof pi with witness\nconstructed from these variables:\na. sk (secret key from phase 1)\nb. RegionID\nc. Path to root, which consists of 2\narrays: Siblings & Hashes\nd. Votes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "W_nWW6Gk0T2qaws7poBK8",
      "originalText": "Client:\n- Generate Proof pi with witness constructed from these variables:\na. sk (secret key from phase 1)\nb. RegionID\nc. Path to root, which consists of 2 arrays: Siblings & Hashes\nd. Votes",
      "autoResize": true,
      "lineHeight": 1.25
    },
