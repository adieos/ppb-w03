      "boundElements": [],
      "updated": 1773201482626,
      "link": null,
      "locked": false,
      "text": "Server checks:\n- If proof valid, continue. Else, reject with\ngeneral message \"Proof invalid\"\n- If Nullifier does NOT exist in DB, continue.\nElse, deny for double-voting\n- Insert vote and nullifier to DB",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "jkscm-jVY4UUhgh8xQEyu",
      "originalText": "Server checks:\n- If proof valid, continue. Else, reject with general message \"Proof invalid\"\n- If Nullifier does NOT exist in DB, continue. Else, deny for double-voting\n- Insert vote and nullifier to DB",
      "autoResize": true,
      "lineHeight": 1.25
    },
